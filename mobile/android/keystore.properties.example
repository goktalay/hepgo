# Release imzalama — bu dosyayı "keystore.properties" olarak kopyalayın ve kendi değerlerinizi girin.
# Gerçek keystore.properties ve .jks dosyaları git'e GİRMEZ (.gitignore). Keystore'u GÜVENLE saklayın;
# kaybederseniz aynı uygulamayı Play'de güncelleyemezsiniz (Play App Signing'de upload key sıfırlanabilir ama yine de yedekleyin).
#
# Keystore oluşturma (bir kez):
#   keytool -genkeypair -v -keystore app/hepgo-upload.jks -alias hepgo \
#           -keyalg RSA -keysize 2048 -validity 10000
#
storeFile=hepgo-upload.jks
storePassword=BURAYA_KEYSTORE_PAROLASI
keyAlias=hepgo
keyPassword=BURAYA_ANAHTAR_PAROLASI
