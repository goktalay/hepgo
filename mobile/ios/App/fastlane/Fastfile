# HEPGO iOS — App Store Connect'e (TestFlight) derleme ve yükleme. GitHub Actions (macOS) üzerinden çalışır.
default_platform(:ios)

platform :ios do
  desc "Derle ve TestFlight'a yükle"
  lane :beta do
    # App Store Connect API anahtarı (.p8 base64 secret'tan) — hem imzalama hem yükleme için
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_P8"],
      is_key_content_base64: true,
      in_house: false
    )

    # Dağıtım sertifikası + provisioning profili (şifreli git deposundan; ilk çalıştırmada API ile üretilir)
    match(
      type: "appstore",
      app_identifier: "com.turkbey.hepgo",
      api_key: api_key,
      readonly: false
    )

    # Xcode projesini MANUEL imzalamaya + match'in ürettiği profile bağla (varsayılan "otomatik, takımsız" hatasını giderir)
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "App.xcodeproj",
      team_id: "5RTGKL4F4Z",
      code_sign_identity: "Apple Distribution",
      profile_name: "match AppStore com.turkbey.hepgo",
      targets: ["App"]
    )

    # Build numarası: GitHub run numarası (her yüklemede artan, benzersiz)
    increment_build_number(
      xcodeproj: "App.xcodeproj",
      build_number: ENV["GITHUB_RUN_NUMBER"] || Time.now.to_i.to_s
    )

    # Arşivle (App Store, manuel imza + match profili)
    gym(
      scheme: "App",
      workspace: "App.xcworkspace",
      export_method: "app-store",
      clean: true,
      output_directory: "output",
      output_name: "HEPGO.ipa",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: { "com.turkbey.hepgo" => "match AppStore com.turkbey.hepgo" }
      }
    )

    # TestFlight'a yükle (işlemeyi bekleme — Apple tarafı sürer)
    pilot(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end
end
