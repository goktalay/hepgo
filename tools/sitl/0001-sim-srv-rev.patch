+/*
+  apply simulated reverse-mounted servos (SIM_SRV_REV bitmask, bit0=SERVO1):
+  mirror the PWM of each flagged channel about 1500us. The vehicle code
+  reverses the output for a reversed servo (SERVOn_REVERSED=1); a reversed
+  mounting on the airframe reverses it back, so the net surface/motor
+  response matches the real aircraft. Applies to every model (plane, copter,
+  ...) since all of them read input.servos. A PWM of 0 (no output) is kept.
+ */
+void Aircraft::apply_servo_reverse_mask(struct sitl_input &input) const
+{
+    const uint32_t mask = sitl != nullptr ? uint32_t(sitl->srv_rev_mask.get()) : 0;
+    if (mask == 0) {
+        return;
+    }
+    for (uint8_t i = 0; i < ARRAY_SIZE(input.servos); i++) {
+        if ((mask & (1U << i)) == 0 || input.servos[i] == 0) {
+            continue;
+        }
+        const uint16_t pwm = constrain_int16(input.servos[i], 1000, 2000);
+        input.servos[i] = 3000 - pwm;
+    }
+}
+
 void Aircraft::update_model(const struct sitl_input &input)
 {
     local_ground_level = 0.0f;
     if (sitl != nullptr) {
-        update(input);
+        if (sitl->srv_rev_mask.get() != 0) {
+            struct sitl_input rev_input = input;
+            apply_servo_reverse_mask(rev_input);
+            update(rev_input);
+        } else {
+            update(input);
+        }
     } else {
         time_advance();
     }
