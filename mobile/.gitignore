# Capacitor mobil — bağımlılıklar ve derleme çıktıları
node_modules/
.DS_Store
*.log

# iOS native proje: kaynağı commit edilir (CI build eder); build çöpü ios/.gitignore'da hariç tutulur.
# Derleme çıktıları / imzalama sırları:
ios/App/build/
ios/App/Pods/
ios/App/output/
ios/App/App/public/
ios/DerivedData/
ios/**/xcuserdata/
ios/fastlane/report.xml
ios/fastlane/Preview.html
ios/**/*.mobileprovision
ios/**/*.p12
ios/**/*.cer

# Android yerel/derleme (android/ kaynağı commit edilir; bunlar hariç)
android/.gradle/
android/build/
android/app/build/
android/captures/
android/local.properties
android/.idea/
android/app/google-services.json

# Release imzalama sırları (ASLA commit edilmez — keystore sahibi saklar)
android/keystore.properties
android/*.jks
android/*.keystore
android/app/*.jks
android/app/*.keystore
