[Unit]
Description=Mastertool web uygulamaları (Notepad Master · Convert Master) — Unix soketi, Cloudflare tüneli önünde (docs/mtweb.md)
After=network.target hepgo-sshmasters.service

[Service]
User=hepgo
Group=hepgo
# Kod HEPGO deposundan çalışır (app/mtweb + HEPGO araç router'ları); veri ve .env YALNIZ mtweb-data altında — HEPGO DB/.env'ine dokunulmaz.
WorkingDirectory=/opt/hepgo/fabrika-yonetim
Environment=CAYMAZ_DATA_DIR=/opt/hepgo/mtweb-data
Environment=MTWEB_DATA_DIR=/opt/hepgo/mtweb-data
Environment=CAYMAZ_ENV_FILE=/opt/hepgo/mtweb-data/.env
Environment=PYTHONUNBUFFERED=1
RuntimeDirectory=hepgo
RuntimeDirectoryPreserve=yes
ExecStart=/opt/hepgo/fabrika-yonetim/.venv/bin/uvicorn app.mtweb.main:app --uds /run/hepgo/mtweb.sock --proxy-headers --forwarded-allow-ips=* --no-server-header
ExecStartPost=/bin/sh -c 'for i in $(seq 1 50); do [ -S /run/hepgo/mtweb.sock ] && chmod 660 /run/hepgo/mtweb.sock && exit 0; sleep 0.2; done'
Restart=on-failure
RestartSec=3
KillMode=mixed
TimeoutStopSec=30
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/hepgo/mtweb-data /run/hepgo
ProtectHome=true
PrivateTmp=true
LimitNOFILE=8192
# Dönüştürücü (ffmpeg) süreçleri ayrıca nice -n 15 + -threads 2 ile çalışır; servis toplamı da sınırlı
CPUQuota=200%
MemoryMax=2G
TasksMax=256

[Install]
WantedBy=multi-user.target
