[Unit]
Description=SIMUMAV dron simülasyon oyunu (simumav.com) — Unix soketi, Cloudflare tüneli önünde; MP TCP 15600–15999
After=network.target hepgo-sshmasters.service

[Service]
User=hepgo
Group=hepgo
WorkingDirectory=/opt/hepgo/caymazbuild
# .env: /opt/hepgo/caymazbuild/.env (SIMUMAV_* anahtarları; bkz. deploy/simumav/README.md)
Environment=SIMUMAV_ENV_FILE=/opt/hepgo/caymazbuild/.env
Environment=SIMUMAV_UDS=/run/hepgo/simumav.sock
Environment=SIMUMAV_DATA_DIR=/opt/hepgo/simumav-data
Environment=HEPGO_SITL_DIR=/opt/hepgo/sitl/bin
RuntimeDirectory=hepgo
RuntimeDirectoryPreserve=yes
ExecStart=/opt/hepgo/caymazbuild/run-simumav.sh
Restart=always
RestartSec=3
KillMode=mixed
TimeoutStopSec=40
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/hepgo/simumav-data /run/hepgo
ProtectHome=true
PrivateTmp=true
LimitNOFILE=16384

[Install]
WantedBy=multi-user.target
